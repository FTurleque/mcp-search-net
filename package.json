{
  "name": "mcp-search-net",
  "version": "1.1.3",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Fabrice Turleque",
  "private": true,
  "description": "Local MCP web search and fetch server for MCP-compatible AI clients",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "exports": "./build/bootstrap/main.js",
  "scripts": {
    "clean": "rimraf build dist",
    "check:runtime": "node scripts/check-node-version.mjs",
    "check:copilot": "node scripts/validate-copilot-config.mjs",
    "check:license": "node scripts/check-license.mjs",
    "check:ci-hygiene": "node scripts/check-ci-hygiene.mjs",
    "check:audit-invariants": "node scripts/check-audit-invariants.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-current-state-durability.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/bootstrap/main.ts",
    "start": "node build/bootstrap/main.js",
    "catalog": "npm run build && node build/cli/catalog.js",
    "catalog:init": "npm run build && node build/cli/catalog.js init",
    "catalog:status": "npm run build && node build/cli/catalog.js status",
    "catalog:health": "npm run build && node build/cli/catalog.js health",
    "catalog:maintain": "npm run build && node build/cli/catalog-maintain.js",
    "catalog:reranked-search": "npm run build && node build/cli/catalog-reranked-search.js",
    "benchmark:v2:search-quality": "npm run build && node scripts/benchmark-v2-search-quality.mjs",
    "benchmark:mcp:size": "npm run build && node scripts/benchmark-mcp-response-scale.mjs",
    "client:contract-report": "node scripts/generate-client-contract-report.mjs",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "node scripts/run-test-suite.mjs coverage vitest.config.ts --coverage",
    "test:watch": "vitest",
    "test:required": "node scripts/run-test-suite.mjs required tests/config/vitest.required.config.ts",
    "test:unit": "node scripts/run-test-suite.mjs unit tests/config/vitest.unit.config.ts",
    "test:contract": "node scripts/run-test-suite.mjs contract tests/config/vitest.contract.config.ts",
    "test:security": "node scripts/run-test-suite.mjs security tests/config/vitest.security.config.ts",
    "test:resilience": "node scripts/run-test-suite.mjs resilience tests/config/vitest.resilience.config.ts",
    "test:performance": "node scripts/run-test-suite.mjs performance tests/config/vitest.performance.config.ts",
    "test:integration": "node scripts/run-test-suite.mjs integration tests/config/vitest.integration.config.ts",
    "test:e2e:deterministic": "vitest run --config tests/config/vitest.required.config.ts tests/e2e/mcp-stdio.test.ts",
    "test:e2e:live": "node scripts/run-live-tests.mjs",
    "test:e2e": "node scripts/run-live-tests.mjs",
    "test:release": "npm run check && npm run test:required && npm run test:unit && npm run test:contract && npm run test:security && npm run test:resilience && npm run test:performance && npm run test:integration && npm run test:e2e",
    "benchmark:v1": "node scripts/benchmark-v1.mjs",
    "install:user": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-user.ps1",
    "install:user:run": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-user.ps1 -StartServices -RunAfterInstall",
    "check": "npm run check:runtime && npm run check:copilot && npm run check:license && npm run check:supply-chain && npm run check:ci-hygiene && npm run check:audit-invariants && npm run docs:check && npm run format:check && npm run lint && npm run typecheck && npm run build && npm run client:contract-report && npm run test:coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "pdfjs-dist": "6.2.108",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.8.0",
    "prettier": "3.6.2",
    "rimraf": "6.1.3",
    "tsx": "^4.16.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "postcss": "8.5.25"
  }
}