{
  "name": "mcp-search-net",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Local MCP web search and fetch server for GitHub Copilot",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": "./build/bootstrap/main.js",
  "scripts": {
    "clean": "rimraf build dist",
    "check:runtime": "node scripts/check-node-version.mjs",
    "check:copilot": "node scripts/validate-copilot-config.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/bootstrap/main.ts",
    "start": "node build/bootstrap/main.js",
    "catalog": "npm run build && node build/cli/catalog.js",
    "catalog:init": "npm run build && node build/cli/catalog.js init",
    "catalog:status": "npm run build && node build/cli/catalog.js status",
    "catalog:maintain": "npm run build && node build/cli/catalog-maintain.js",
    "catalog:hybrid-search": "npm run build && node build/cli/catalog-hybrid-search.js",
    "benchmark:v2:hybrid": "npm run build && node scripts/benchmark-v2-hybrid.mjs",
    "benchmark:mcp:size": "npm run build && node scripts/benchmark-mcp-response-size.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "node scripts/run-test-suite.mjs coverage vitest.config.ts --coverage",
    "test:watch": "vitest",
    "test:required": "node scripts/run-test-suite.mjs required vitest.required.config.ts",
    "test:unit": "node scripts/run-test-suite.mjs unit vitest.unit.config.ts",
    "test:contract": "node scripts/run-test-suite.mjs contract vitest.contract.config.ts",
    "test:security": "node scripts/run-test-suite.mjs security vitest.security.config.ts",
    "test:resilience": "node scripts/run-test-suite.mjs resilience vitest.resilience.config.ts",
    "test:performance": "node scripts/run-test-suite.mjs performance vitest.performance.config.ts",
    "test:integration": "node scripts/run-test-suite.mjs integration vitest.integration.config.ts",
    "test:e2e:deterministic": "vitest run --config vitest.required.config.ts tests/e2e/mcp-stdio.test.ts",
    "test:e2e:live": "node scripts/run-live-tests.mjs",
    "test:e2e": "node scripts/run-live-tests.mjs",
    "test:release": "npm run check && npm run test:required && npm run test:unit && npm run test:contract && npm run test:security && npm run test:resilience && npm run test:performance && npm run test:integration && npm run test:e2e",
    "benchmark:v1": "node scripts/benchmark-v1.mjs",
    "install:user": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-user.ps1",
    "install:user:run": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-user.ps1 -StartServices -RunAfterInstall",
    "check": "npm run check:runtime && npm run check:copilot && npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "^12.0.0",
    "pdfjs-dist": "6.0.227",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "rimraf": "6.1.3",
    "tsx": "^4.16.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.9"
  }
}
