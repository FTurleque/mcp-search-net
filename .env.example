# Copiez ce fichier vers .env uniquement pour le développement local.
# Ces valeurs sont des exemples et ne sont pas des secrets de production.
MCP_CONFIG_PATH=./config/application.yml
MCP_PROFILE=development
MCP_LOG_LEVEL=info
MCP_CACHE_PATH=../.data/cache.sqlite
MCP_CATALOG_PATH=../.data/catalog.db
MCP_HISTORY_PATH=../.data/history.sqlite
MCP_OFFICIAL_SOURCES_PATH=official-sources.yml
MCP_SEARXNG_URL=http://127.0.0.1:8888
MCP_CRAWL4AI_URL=http://127.0.0.1:11235
MCP_CRAWL4AI_TOKEN=replace-with-a-random-local-token
MCP_ALLOWED_PUBLIC_PORTS=80,443

# Variables consommées directement par les conteneurs fournisseurs.
CRAWL4AI_API_TOKEN=replace-with-the-same-random-local-token
SEARXNG_SECRET=replace-with-a-random-secret
